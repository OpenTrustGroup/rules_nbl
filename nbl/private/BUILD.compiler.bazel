load(":cc_config-%{COMPILER_TARGET}%.bzl", "cc_toolchain_config")
load("@rules_cc//cc:defs.bzl", "cc_toolchain")

package(default_visibility = ["//visibility:public"])

toolchain(
    name = "%{COMPILER_TARGET}%",
    exec_compatible_with = [
        "@bazel_tools//platforms:linux",
        "@bazel_tools//platforms:x86_64",
    ],
    target_compatible_with = [
        "@platforms//cpu:arm64",
        "@io_bazel_rules_nbl//platforms:%{COMPILER_TARGET}%",
    ],
    toolchain = ":%{COMPILER_TARGET}%-impl",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

cc_toolchain(
    name = "%{COMPILER_TARGET}%-impl",
    all_files = ":all",
    compiler_files = ":all",
    dwp_files = ":empty",
    linker_files = ":all",
    objcopy_files = ":all",
    strip_files = ":all",
    toolchain_config = ":config",
)

cc_toolchain_config(
    name = "config",
)

filegroup(
    name = "all",
    srcs = glob([
        "**/*",
    ]),
)

filegroup(
    name = "empty",
    srcs = [],
)
