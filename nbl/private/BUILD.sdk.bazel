load(":cc_toolchain_config.bzl", "cc_toolchain_config")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "create_archive_manifest",
    srcs = glob(["host/x64/create_archive_manifest"]),
)

filegroup(
    name = "far",
    srcs = glob(["host/x64/far"]),
)

toolchain(
    name = "clang_fuchsia_aarch64",
    exec_compatible_with = [
        "@bazel_tools//platforms:linux",
        "@bazel_tools//platforms:x86_64",
    ],
    target_compatible_with = [
        "@platforms//cpu:arm64",
    ],
    toolchain = ":clang_fuchsia_aarch64-impl",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

cc_toolchain(
    name = "clang_fuchsia_aarch64-impl",
    all_files = ":all",
    compiler_files = ":all",
    dwp_files = ":empty",
    linker_files = ":all",
    objcopy_files = ":all",
    strip_files = ":all",
    toolchain_config = ":aarch64_config",
)

cc_toolchain_config(
    name = "aarch64_config",
)

filegroup(
    name = "all",
    srcs = glob([
        "hee/**",
        "host/**",
        "toolchains/clang/**",
    ]),
)

filegroup(
    name = "empty",
    srcs = [],
)
