load(":cc_toolchain_config.bzl", "cc_toolchain_config")
load("@rules_cc//cc:defs.bzl", "cc_toolchain")
load("@io_bazel_rules_nbl//nbl/private:sdk.bzl", "nbl_sdk")
load("@io_bazel_rules_nbl//nbl/private:nbl_toolchain.bzl", "declare_toolchains")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "create_archive_manifest",
    srcs = ["host/x64/create_archive_manifest"],
)

filegroup(
    name = "far",
    srcs = ["host/x64/far"],
)

filegroup(
    name = "otrp_provision_exe",
    srcs = ["run/otrp/provision_tool/provision_create_ha_by_config.sh"],
)

filegroup(
    name = "otrp_keystore",
    srcs = ["run/otrp/key_store_test"],
)

filegroup(
    name = "otrp_provision_tool_suite",
    srcs = glob([
        "run/otrp/provision_tool/*.sh",
        "run/otrp/provision_tool/*.jar",
    ]),
)

filegroup(
    name = "otrp_sign_tool_suite",
    srcs = glob([
        "run/otrp/sign_tool/*.sh",
        "run/otrp/sign_tool/*.jar",
    ]),
)

filegroup(
    name = "otrp_elf_tool_suite",
    srcs = glob([
        "run/otrp/elf_tool/*",
        "run/otrp/sign_tool/*.jar",
    ]),
)

filegroup(
    name = "otrp_suite",
    srcs = [
        ":otrp_elf_tool_suite",
        ":otrp_provision_tool_suite",
        ":otrp_sign_tool_suite",
    ],
)

filegroup(
    name = "nblruncmd",
    srcs = select({
        "@io_bazel_rules_nbl//nbl:cfg_android": ["android/bin/nblruncmd"],
        "//conditions:default": ["ree/bin/nblruncmd"],
    }),
)

nbl_sdk(
    name = "%{SDK_NAME}%",
    host_create_archive_manifest = ":create_archive_manifest",
    host_far = ":far",
    otrp_keystore = ":otrp_keystore",
    otrp_provision_exe = ":otrp_provision_exe",
    otrp_suite = ":otrp_suite",
    path = "%{SDK_PATH}%",
    target_nblruncmd = ":nblruncmd",
)

declare_toolchains(
    sdk = "%{SDK_NAME}%",
)

toolchain(
    name = "clang_fuchsia_aarch64",
    exec_compatible_with = [
        "@bazel_tools//platforms:linux",
        "@bazel_tools//platforms:x86_64",
    ],
    target_compatible_with = [
        "@platforms//cpu:arm64",
    ],
    toolchain = ":clang_fuchsia_aarch64-impl",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

cc_toolchain(
    name = "clang_fuchsia_aarch64-impl",
    all_files = ":all",
    compiler_files = ":all",
    dwp_files = ":empty",
    linker_files = ":all",
    objcopy_files = ":all",
    strip_files = ":all",
    toolchain_config = ":aarch64_config",
)

cc_toolchain_config(
    name = "aarch64_config",
)

filegroup(
    name = "all",
    srcs = glob([
        "hee/**",
        "host/**",
        "toolchains/clang/**",
    ]),
)

filegroup(
    name = "empty",
    srcs = [],
)
