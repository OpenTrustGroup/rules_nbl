load(":cc_toolchain_config.bzl", "cc_toolchain_config")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "create_archive_manifest",
    srcs = glob(["host/x64/create_archive_manifest"]),
)

filegroup(
    name = "far",
    srcs = glob(["host/x64/far"]),
)

filegroup(
    name = "secmgr_debug_tool",
    srcs = glob(["run/otrp/debug_tool/secmgr_debug_tool.jar"]),
)

filegroup(
    name = "otrp_runfiles",
    srcs = glob([
        "run/otrp/**/*.sh",
        "run/otrp/**/*.jar",
    ]),
)

filegroup(
    name = "secmgr_debug",
    srcs = glob(["run/otrp/debug_tool/secmgr_debug.sh"]),
)

filegroup(
    name = "otrp_provision",
    srcs = glob(["run/otrp/provision_tool/provision_create_ha_by_config.sh"]),
)

filegroup(
    name = "otrp_keystore",
    srcs = glob(
        ["run/otrp/key_store_test"],
        exclude_directories = 0,
    ),
)

filegroup(
    name = "otrp_provision_tool",
    srcs = glob([
        "run/otrp/provision_tool/*.sh",
        "run/otrp/provision_tool/*.jar",
    ]),
)

filegroup(
    name = "otrp_sign_tool",
    srcs = glob([
        "run/otrp/sign_tool/*.sh",
        "run/otrp/sign_tool/*.jar",
    ]),
)

filegroup(
    name = "otrp_elf_tool",
    srcs = glob([
        "run/otrp/elf_tool/*",
        "run/otrp/sign_tool/*.jar",
    ]),
)

toolchain(
    name = "clang_fuchsia_aarch64",
    exec_compatible_with = [
        "@bazel_tools//platforms:linux",
        "@bazel_tools//platforms:x86_64",
    ],
    target_compatible_with = [
        "@platforms//cpu:arm64",
    ],
    toolchain = ":clang_fuchsia_aarch64-impl",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

cc_toolchain(
    name = "clang_fuchsia_aarch64-impl",
    all_files = ":all",
    compiler_files = ":all",
    dwp_files = ":empty",
    linker_files = ":all",
    objcopy_files = ":all",
    strip_files = ":all",
    toolchain_config = ":aarch64_config",
)

cc_toolchain_config(
    name = "aarch64_config",
)

filegroup(
    name = "all",
    srcs = glob([
        "hee/**",
        "host/**",
        "toolchains/clang/**",
    ]),
)

filegroup(
    name = "empty",
    srcs = [],
)
